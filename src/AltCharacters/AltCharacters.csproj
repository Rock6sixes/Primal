<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>AltCharacters</AssemblyName>
    <RootNamespace>AltCharacters</RootNamespace>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Lets this project build on Linux/CI without network access to nuget.org, by using
       Mono's local net48 reference assemblies instead of restoring
       Microsoft.NETFramework.ReferenceAssemblies. No effect on Windows. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api/</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game + BepInEx reference assemblies, copied from the Rain World install. Never shipped, never modified in place. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\lib\PUBLIC-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\lib\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\lib\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SlugBase">
      <HintPath>..\..\lib\SlugBase.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After building, drop the plugin dll into mod/plugins so the whole mod/ folder is
       ready to symlink or copy straight into Rain World's StreamingAssets/mods. -->
  <Target Name="CopyToModFolder" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\mod\plugins" Condition="!Exists('$(MSBuildProjectDirectory)\mod\plugins')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\mod\plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
